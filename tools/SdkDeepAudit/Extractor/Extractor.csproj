<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>$(DeepAuditFlavor)</AssemblyName>
    <OutputPath>$(DeepAuditOutput)\bin\</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ClangSharpBinaryRoot Condition="'$(ClangSharpBinaryRoot)' == ''">L:\Open_Code\win32metadata\bin\Release\net10.0\win-x64</ClangSharpBinaryRoot>
  </PropertyGroup>
  <ItemGroup><Reference Include="ClangSharp.Interop"><HintPath>$(ClangSharpBinaryRoot)\ClangSharp.Interop.dll</HintPath></Reference></ItemGroup>
  <Target Name="RestoreAuditReferences" BeforeTargets="PrepareForBuild" Condition="!Exists('$(ProjectAssetsFile)') and '$(DeepAuditRestore)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore" Properties="DeepAuditRestore=true" />
  </Target>
</Project>
